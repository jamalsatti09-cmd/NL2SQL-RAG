# ─────────────────────────────────────────────────────────────
#  NL2SQL-RAG  —  Environment Configuration
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────

# ── LLM Backend (set at least ONE) ───────────────────────────

# ⭐ GROQ — FREE, no credit card, 6000 req/day, very fast
# Get key at: https://console.groq.com  (30-second signup)
GROQ_API_KEY=your_groq_key_here

# Google Gemini — free tier (leave blank if using Groq)
GEMINI_API_KEY=

# OpenAI — paid (leave blank if using Groq)
OPENAI_API_KEY=

# Local Ollama — set USE_LOCAL_LLM=true and ensure Ollama is running
USE_LOCAL_LLM=false
OLLAMA_MODEL=llama3.1:8b

# ── Vector Store ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────
TOP_K_SCHEMA=10
TOP_K_FEWSHOT=5
USE_RERANKER=false

# ── Execution ─────────────────────────────────────────────────
MAX_RETRIES=2
ALLOW_EMPTY_RESULTS=true
DEFAULT_DB_URL=sqlite:///./test.db

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
